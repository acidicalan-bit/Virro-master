# Supabase (new key names preferred; legacy values remain compatible during migration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key

# Legacy compatibility only; never expose the privileged value in NEXT_PUBLIC_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-legacy-anon-key-if-needed
SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-server-only-service-role-key-if-needed

# Authenticated Field Beta uses cookie-based Supabase SSR and durable tenant membership.
# Email confirmation should remain enabled for production-like accounts.

# Main Intent Lab compiler. Use "heuristic" for deterministic local development,
# or "openai" to compile through the real Responses API adapter.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-openai-project-api-key
OPENAI_INTENT_MODEL=gpt-5.6-luna
LLM_MODEL_VERSION=

# Precision Edit BUILD 004. Select explicitly; there is no provider fallback.
IMAGE_EDIT_PROVIDER=openai
# Required only for the zero-provider readiness harness; never enable in production.
FIELD_BETA_CONTROLLED_EXECUTOR=false
OPENAI_IMAGE_EDIT_MODEL=gpt-image-2

# Blind evaluation always compares the frozen heuristic baseline against OpenAI.
# It never falls back to the heuristic if OpenAI fails.
BLIND_EVAL_CANDIDATE_PROVIDER=openai

# Compiler metadata
INTENT_COMPILER_VERSION=0.1.1

# BUILD 005 is internal-only and disabled by default. It never authorizes canonical commits.
FIELD_BETA_INTERNAL_ENABLED=false
FIELD_EVAL_SAMPLING_RATE=0

# Legacy service-role routes are disabled by default and cannot be enabled in production.
# This is an internal migration switch, never an authorization mechanism.
INTERNAL_LEGACY_ROUTES_ENABLED=false
