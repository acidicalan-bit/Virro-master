# Supabase (server-side writes use the service role key; never expose it in NEXT_PUBLIC_ variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional publishable values for future client-side, RLS-protected reads.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Intent model. Use "heuristic" for deterministic local development without an API key.
LLM_PROVIDER=heuristic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-provider-api-key
LLM_MODEL=gpt-5-mini
LLM_MODEL_VERSION=

# Compiler metadata
INTENT_COMPILER_VERSION=0.1.0
