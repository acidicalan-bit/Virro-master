{
  "name": "intent-lab",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:model": "vitest run tests/security/build001-trust-foundation.test.ts --reporter=verbose",
    "test:application": "vitest run tests/security/build001-f2-legacy-precision-edit-isolation.test.ts --reporter=verbose",
    "test:sql": "vitest run tests/integration/build001-f1-canonical-commit.integration.test.ts --reporter=verbose",
    "test:security": "vitest run tests/security tests/assurance --reporter=verbose",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:staging": "node scripts/assurance/staging-preflight.mjs && vitest run tests/integration/build001-trust-foundation.integration.test.ts --reporter=verbose",
    "test:assurance": "vitest run tests/assurance --reporter=verbose",
    "assurance:manifest": "node scripts/assurance/generate-build001-manifest.mts",
    "assurance:check": "node scripts/assurance/generate-build001-manifest.mts --check",
    "assurance:environment": "node scripts/assurance/environment-status.mjs",
    "portability:check": "node scripts/portability/check.mjs",
    "portability:env": "node scripts/portability/env-audit.mjs",
    "portability:smoke": "node scripts/portability/container-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.57.4",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@typescript-eslint/scope-manager": "8.66.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.0",
    "jsdom": "^27.0.1",
    "pg": "^8.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
